generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model College {
  id               Int      @id @default(autoincrement())
  name             String
  location         String
  state            String
  fees             Int
  rating           Float
  placementAverage Float
  placementHighest Float
  description      String
  website          String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  courses          Course[]
  reviews          Review[]
  cutoffs          Cutoff[]
  savedBy          SavedCollege[]
}

model Course {
  id        Int      @id @default(autoincrement())
  name      String
  duration  String
  fees      Int
  collegeId Int

  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model Review {
  id        Int      @id @default(autoincrement())
  userName  String
  rating    Float
  comment   String
  createdAt DateTime @default(now())
  collegeId Int

  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model Cutoff {
  id        Int      @id @default(autoincrement())
  exam      String
  minRank   Int
  maxRank   Int
  collegeId Int

  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedColleges SavedCollege[]
}

model SavedCollege {
  id        Int      @id @default(autoincrement())
  userId    Int
  collegeId Int

  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
}